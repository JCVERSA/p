# GEMINI_API_KEY: Required for Gemini AI API calls (text, image, transcription, voice).
# Configure via Settings -> Secrets (masked, never returned to the browser).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL of the panel (e.g. https://bot.example.com).
# Used for self-referential links and Host-header validation (M3): when set,
# requests with a foreign Host header are rejected.
APP_URL="MY_APP_URL"

# PANEL_TOKEN: REQUIRED for panel logins. The panel UI now asks for this key
# once, exchanges it for a server-side session cookie (HttpOnly, 12h sliding),
# and never stores it in the browser. If unset, a random key is generated at
# startup and printed once to the server console. Also accepted as a bearer
# token for scripts/tooling.
PANEL_TOKEN=""

# NEBULA_PANEL_COMMANDS: "on" (default) enables panel-created commands in the
# capability-limited sandbox. Set "off" to disable the feature entirely.
NEBULA_PANEL_COMMANDS="on"

# NEBULA_AI_DAILY_LIMIT: per-sender daily AI request budget (default 40).
NEBULA_AI_DAILY_LIMIT="40"

# NEBULA_AI_MAX_CONCURRENT: global cap on simultaneous AI requests (default 3).
NEBULA_AI_MAX_CONCURRENT="3"

# NEBULA_TEMP_MAX_BYTES: total bytes the temp-download storage may hold
# (default 4 GiB). Records over 200 are rejected as well.
NEBULA_TEMP_MAX_BYTES="4294967296"

# NEBULA_NOVABOX_MAX_EPISODES: cap on batch episodes per request (default 12).
NEBULA_NOVABOX_MAX_EPISODES="12"

# NEBULA_NOVABOX_MAX_BATCH_MB: total bytes for a batch (default 2048 MB).
NEBULA_NOVABOX_MAX_BATCH_MB="2048"

# NEBULA_ALLOW_SELF_UPDATE: "1" enables the owner-only .update command
# (downloads a code ZIP from allowlisted code-hosting hosts and rewrites the
# app). Unset = disabled. Prefer a git pull + restart instead.
NEBULA_ALLOW_SELF_UPDATE="0"

# ADMIN_NUMBERS: Optional. Comma-separated WhatsApp numbers granted the admin
# role for RoleGuard group policies.
ADMIN_NUMBERS=""

# PORT: HTTP port for the panel server (default 3000).
PORT=3000

# NEBULA_DATA_DIR: Directory for runtime state (config, access policies,
# panel commands, stats, sessions). Defaults to ./database.
NEBULA_DATA_DIR=""
